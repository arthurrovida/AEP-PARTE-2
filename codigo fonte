#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#ifdef _WIN32
#include <windows.h>
#endif

#define MAX_ACOES        100
#define TAM_CODIGO       16
#define TAM_TEXTO        60
#define TAM_DATA         11
#define ARQUIVO_DADOS    "acoes.txt"
#define USUARIO_PADRAO   "admin"
#define SENHA_PADRAO     "pse2026"
#define MAX_TENTATIVAS   3

typedef enum {
    PLANEJADA = 1,
    REALIZADA = 2,
    CANCELADA = 3
} Situacao;

typedef struct {
    char codigo[TAM_CODIGO];
    char escola[TAM_TEXTO];
    char tema[TAM_TEXTO];
    char data[TAM_DATA];
    char publico[TAM_TEXTO];
    char responsavel[TAM_TEXTO];
    int  qtdPrevista;
    int  qtdEfetiva;
    Situacao situacao;
} Acao;

static Acao acoes[MAX_ACOES];
static int  totalAcoes = 0;

static void limparTela(void) {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

static void removerEspacosBordas(char *s) {
    size_t ini = 0, fim = strlen(s);
    while (s[ini] != '\0' && isspace((unsigned char)s[ini])) ini++;
    while (fim > ini && isspace((unsigned char)s[fim - 1])) fim--;
    memmove(s, s + ini, fim - ini);
    s[fim - ini] = '\0';
}

static void lerLinha(const char *msg, char *dest, size_t tam) {
    int c;
    size_t i;

    printf("%s", msg);
    if (fgets(dest, (int)tam, stdin) == NULL) {
        dest[0] = '\0';
        clearerr(stdin);
        return;
    }
    if (strchr(dest, '\n') == NULL) {
        while ((c = getchar()) != '\n' && c != EOF) {  }
    }
    dest[strcspn(dest, "\n")] = '\0';
    removerEspacosBordas(dest);
    for (i = 0; dest[i] != '\0'; i++) {
        if (dest[i] == '|') dest[i] = '-';
    }
}

static int lerInteiro(const char *msg, int min, int max) {
    char buf[32];
    char *fim;
    long valor;

    for (;;) {
        lerLinha(msg, buf, sizeof(buf));
        if (buf[0] == '\0') {
            printf("  [Erro] Digite um numero valido.\n");
            continue;
        }
        valor = strtol(buf, &fim, 10);
        if (*fim != '\0') {
            printf("  [Erro] Entrada invalida. Digite apenas numeros.\n");
        } else if (valor < min || valor > max) {
            if (min == 0)
                printf("  [Erro] Quantidade nao pode ser negativa (maximo %d).\n", max);
            else
                printf("  [Erro] Valor fora do intervalo permitido (%d a %d).\n", min, max);
        } else {
            return (int)valor;
        }
    }
}

static void lerObrigatorio(const char *msg, char *dest, size_t tam) {
    for (;;) {
        lerLinha(msg, dest, tam);
        if (dest[0] != '\0') return;
        printf("  [Erro] Campo obrigatorio. Por favor, preencha.\n");
    }
}

static void pausar(void) {
    char tmp[8];
    printf("\n------------------------------------------------------------------------------------\n");
    printf("Pressione ENTER para continuar...");
    if (fgets(tmp, sizeof(tmp), stdin) == NULL) clearerr(stdin);
}

static int igualIgnorandoCaixa(const char *a, const char *b) {
    while (*a && *b) {
        if (tolower((unsigned char)*a) != tolower((unsigned char)*b)) return 0;
        a++; b++;
    }
    return *a == '\0' && *b == '\0';
}

static int contemIgnorandoCaixa(const char *texto, const char *busca) {
    size_t i, j, n = strlen(texto), m = strlen(busca);
    if (m == 0) return 1;
    if (m > n) return 0;
    for (i = 0; i + m <= n; i++) {
        for (j = 0; j < m; j++) {
            if (tolower((unsigned char)texto[i + j]) != tolower((unsigned char)busca[j])) break;
        }
        if (j == m) return 1;
    }
    return 0;
}

static const char *nomeSituacao(Situacao s) {
    switch (s) {
        case PLANEJADA: return "Planejada";
        case REALIZADA: return "Realizada";
        case CANCELADA: return "Cancelada";
    }
    return "?";
}

static int dataValida(const char *d) {
    int dia, mes, ano, diasMes, i;
    static const int dm[12] = {31,28,31,30,31,30,31,31,30,31,30,31};

    if (strlen(d) != 10 || d[2] != '/' || d[5] != '/') return 0;
    for (i = 0; i < 10; i++) {
        if (i == 2 || i == 5) continue;
        if (!isdigit((unsigned char)d[i])) return 0;
    }
    dia = atoi(d);
    mes = atoi(d + 3);
    ano = atoi(d + 6);
    if (ano < 2000 || ano > 2100 || mes < 1 || mes > 12) return 0;
    diasMes = dm[mes - 1];
    if (mes == 2 && ((ano % 4 == 0 && ano % 100 != 0) || ano % 400 == 0)) diasMes = 29;
    return dia >= 1 && dia <= diasMes;
}

static int buscarIndicePorCodigo(const char *codigo) {
    int i;
    for (i = 0; i < totalAcoes; i++) {
        if (igualIgnorandoCaixa(acoes[i].codigo, codigo)) return i;
    }
    return -1;
}

static void salvarAcoes(void) {
    FILE *f = fopen(ARQUIVO_DADOS, "w");
    int i;
    if (f == NULL) {
        printf("  [Aviso] Nao foi possivel salvar os dados em '%s'.\n", ARQUIVO_DADOS);
        return;
    }
    for (i = 0; i < totalAcoes; i++) {
        fprintf(f, "%s|%s|%s|%s|%s|%s|%d|%d|%d\n",
                acoes[i].codigo, acoes[i].escola, acoes[i].tema, acoes[i].data,
                acoes[i].publico, acoes[i].responsavel,
                acoes[i].qtdPrevista, acoes[i].qtdEfetiva, (int)acoes[i].situacao);
    }
    fclose(f);
}

static void carregarAcoes(void) {
    FILE *f = fopen(ARQUIVO_DADOS, "r");
    char linha[512];

    totalAcoes = 0;
    if (f == NULL) return;

    while (totalAcoes < MAX_ACOES && fgets(linha, sizeof(linha), f) != NULL) {
        Acao a;
        char *campos[9];
        char *p = linha;
        int n = 0, sit;

        linha[strcspn(linha, "\r\n")] = '\0';
        campos[n++] = p;
        while (*p && n < 9) {
            if (*p == '|') { *p = '\0'; campos[n++] = p + 1; }
            p++;
        }
        if (n != 9) continue;

        memset(&a, 0, sizeof(a));
        strncpy(a.codigo,     campos[0], TAM_CODIGO - 1);
        strncpy(a.escola,     campos[1], TAM_TEXTO - 1);
        strncpy(a.tema,       campos[2], TAM_TEXTO - 1);
        strncpy(a.data,       campos[3], TAM_DATA - 1);
        strncpy(a.publico,    campos[4], TAM_TEXTO - 1);
        strncpy(a.responsavel,campos[5], TAM_TEXTO - 1);
        a.qtdPrevista = atoi(campos[6]);
        a.qtdEfetiva  = atoi(campos[7]);
        sit = atoi(campos[8]);
        if (sit < PLANEJADA || sit > CANCELADA) continue;
        a.situacao = (Situacao)sit;
        if (a.codigo[0] == '\0' || a.qtdPrevista < 0 || a.qtdEfetiva < 0) continue;
        if (buscarIndicePorCodigo(a.codigo) >= 0) continue;

        acoes[totalAcoes++] = a;
    }
    fclose(f);
}

static void exibirCabecalhoTabela(void) {
    printf("\n  %-8s | %-18s | %-18s | %-10s | %-8s | %-8s | %-10s\n",
           "Codigo", "Escola", "Tema", "Data", "Prev.", "Efet.", "Situacao");
    printf("  ------------------------------------------------------------------------------------------\n");
}

static void exibirLinhaTabela(const Acao *a) {
    printf("  %-8.8s | %-18.18s | %-18.18s | %-10s | %-8d | ", 
           a->codigo, a->escola, a->tema, a->data, a->qtdPrevista);
    if (a->situacao == REALIZADA) printf("%-8d | ", a->qtdEfetiva);
    else                          printf("%-8s | ", "-");
    printf("%-10s\n", nomeSituacao(a->situacao));
}

static void exibirDetalhe(const Acao *a) {
    printf("\n  +--------------------------------------------------------+\n");
    printf("  | DETALHES DA ACAO                                       |\n");
    printf("  +--------------------------------------------------------+\n");
    printf("  | Codigo ........: %-37s |\n", a->codigo);
    printf("  | Escola ........: %-37s |\n", a->escola);
    printf("  | Tema ..........: %-37s |\n", a->tema);
    printf("  | Data prevista .: %-37s |\n", a->data);
    printf("  | Publico-alvo ..: %-37s |\n", a->publico);
    printf("  | Responsavel ...: %-37s |\n", a->responsavel);
    printf("  | Qtd. prevista .: %-37d |\n", a->qtdPrevista);
    if (a->situacao == REALIZADA)
        printf("  | Qtd. efetiva ..: %-37d |\n", a->qtdEfetiva);
    printf("  | Situacao ......: %-37s |\n", nomeSituacao(a->situacao));
    printf("  +--------------------------------------------------------+\n");
}

