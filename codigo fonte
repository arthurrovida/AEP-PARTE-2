    limparTela();
    printf("\n");
    printf("  +--------------------------------------------------------+\n");
    printf("  |                    PSE EM ACAO - MENU                  |\n");
    printf("  +--------------------------------------------------------+\n");
    printf("  |  [1] Cadastrar nova acao                               |\n");
    printf("  |  [2] Listar todas as acoes                             |\n");
    printf("  |  [3] Pesquisar acao                                    |\n");
    printf("  |  [4] Atualizar situacao                                |\n");
    printf("  |  [5] Gerar resumo geral                                |\n");
    printf("  |  [6] Encerrar sistema                                  |\n");
    printf("  +--------------------------------------------------------+\n");
}

static void cadastrarAcao(void) {
    Acao a;
    char codigo[TAM_CODIGO];

    limparTela();
    printf("\n  === CADASTRAR ACAO ===\n");
    if (totalAcoes >= MAX_ACOES) {
        printf("  [Erro] Limite de %d acoes atingido.\n", MAX_ACOES);
        return;
    }

    memset(&a, 0, sizeof(a));

    for (;;) {
        lerObrigatorio("  Codigo da acao (ex.: A001): ", codigo, sizeof(codigo));
        if (buscarIndicePorCodigo(codigo) >= 0) printf("  [Erro] Este codigo ja existe.\n");
        else break;
    }
    strcpy(a.codigo, codigo);

    lerObrigatorio("  Escola: ", a.escola, sizeof(a.escola));
    lerObrigatorio("  Tema (ex.: Saude bucal): ", a.tema, sizeof(a.tema));

    for (;;) {
        lerObrigatorio("  Data prevista (dd/mm/aaaa): ", a.data, sizeof(a.data));
        if (dataValida(a.data)) break;
        printf("  [Erro] Data invalida. Use o formato dd/mm/aaaa.\n");
    }

    lerObrigatorio("  Publico-alvo (ex.: 6o ano): ", a.publico, sizeof(a.publico));
    lerObrigatorio("  Responsavel: ", a.responsavel, sizeof(a.responsavel));
    a.qtdPrevista = lerInteiro("  Quantidade prevista de participantes: ", 0, 100000);

    a.qtdEfetiva = 0;
    a.situacao = PLANEJADA;

    acoes[totalAcoes++] = a;
    salvarAcoes();
    printf("\n  [Sucesso] Cadastro realizado com sucesso!\n");
}

static void listarAcoes(void) {
    int i;
    limparTela();
    printf("\n  === LISTA DE ACOES ===\n");
    if (totalAcoes == 0) {
        printf("  Nenhuma acao cadastrada no momento.\n");
        return;
    }
    exibirCabecalhoTabela();
    for (i = 0; i < totalAcoes; i++) exibirLinhaTabela(&acoes[i]);
    printf("\n  Total: %d acao(oes) registrada(s).\n", totalAcoes);
}

static void pesquisarAcao(void) {
    char termo[TAM_TEXTO];
    int opcao, i, achou = 0;

    limparTela();
    printf("\n  === PESQUISAR ACAO ===\n");
    if (totalAcoes == 0) {
        printf("  Nenhuma acao cadastrada.\n");
        return;
    }
    printf("  [1] Por codigo\n  [2] Por escola\n  [3] Por tema\n");
    opcao = lerInteiro("  Pesquisar por opcao: ", 1, 3);
    lerObrigatorio("  Termo de busca: ", termo, sizeof(termo));

    for (i = 0; i < totalAcoes; i++) {
        int bate = 0;
        if (opcao == 1)      bate = igualIgnorandoCaixa(acoes[i].codigo, termo);
        else if (opcao == 2) bate = contemIgnorandoCaixa(acoes[i].escola, termo);
        else                 bate = contemIgnorandoCaixa(acoes[i].tema, termo);

        if (bate) {
            achou++;
            exibirDetalhe(&acoes[i]);
        }
    }
    if (!achou) printf("\n  [Aviso] Nenhuma acao encontrada para \"%s\".\n", termo);
    else        printf("\n  [Info] Total de %d acao(oes) encontrada(s).\n", achou);
}

static void atualizarSituacao(void) {
    char codigo[TAM_CODIGO];
    int idx, nova;

    limparTela();
    printf("\n  === ATUALIZAR SITUACAO ===\n");
    if (totalAcoes == 0) {
        printf("  Nenhuma acao cadastrada.\n");
        return;
    }
    lerObrigatorio("  Codigo da acao: ", codigo, sizeof(codigo));
    idx = buscarIndicePorCodigo(codigo);
    if (idx < 0) {
        printf("  [Erro] Nenhuma acao encontrada com esse codigo.\n");
        return;
    }

    exibirDetalhe(&acoes[idx]);
    printf("\n  [1] Planejada\n  [2] Realizada\n  [3] Cancelada\n");
    nova = lerInteiro("  Nova situacao: ", 1, 3);

    acoes[idx].situacao = (Situacao)nova;
    if (nova == REALIZADA) {
        acoes[idx].qtdEfetiva = lerInteiro("  Quantidade efetiva de participantes: ", 0, 100000);
    } else {
        acoes[idx].qtdEfetiva = 0;
    }
    salvarAcoes();
    printf("\n  [Sucesso] Situacao atualizada para: %s.\n", nomeSituacao(acoes[idx].situacao));
}

static void gerarResumo(void) {
    int i, planejadas = 0, realizadas = 0, canceladas = 0;
    long totalEfetivo = 0, previstoRealizadas = 0;
    double percentual;

    limparTela();
    printf("\n  +--------------------------------------------------------+\n");
    printf("  |                       RESUMO GERAL                     |\n");
    printf("  +--------------------------------------------------------+\n");
    
    if (totalAcoes == 0) {
        printf("  |  Nenhuma acao cadastrada no momento.                   |\n");
        printf("  +--------------------------------------------------------+\n");
        return;
    }

    for (i = 0; i < totalAcoes; i++) {
        switch (acoes[i].situacao) {
            case PLANEJADA: planejadas++; break;
            case REALIZADA:
                realizadas++;
                totalEfetivo += acoes[i].qtdEfetiva;
                previstoRealizadas += acoes[i].qtdPrevista;
                break;
            case CANCELADA: canceladas++; break;
        }
    }

    printf("  |  Total de acoes cadastradas ..: %-20d |\n", totalAcoes);
    printf("  |  Acoes planejadas ............: %-20d |\n", planejadas);
    printf("  |  Acoes realizadas ............: %-20d |\n", realizadas);
    printf("  |  Acoes canceladas ............: %-20d |\n", canceladas);
    printf("  |  Total de participantes ......: %-20ld |\n", totalEfetivo);
    
    if (previstoRealizadas > 0) {
        percentual = (double)totalEfetivo * 100.0 / (double)previstoRealizadas;
        printf("  |  Participacao vs Previsto ....: %-5.1f%%                 |\n", percentual);
    } else {
        printf("  |  Participacao vs Previsto ....: Indisponivel           |\n");
    }
    printf("  +--------------------------------------------------------+\n");
}

static int fazerLogin(void) {
    char usuario[32], senha[32];
    int tentativa;

    limparTela();
    printf("\n");
    printf("  +--------------------------------------------------------+\n");
    printf("  |                       PSE EM ACAO                      |\n");
    printf("  |         Planejamento e Acompanhamento de Acoes         |\n");
    printf("  |                    de Saude na Escola                  |\n");
    printf("  +--------------------------------------------------------+\n");
    printf("  |  Demo de acesso: admin / pse2026                       |\n");
    printf("  +--------------------------------------------------------+\n\n");

    for (tentativa = 1; tentativa <= MAX_TENTATIVAS; tentativa++) {
        lerLinha("  Usuario: ", usuario, sizeof(usuario));
        lerLinha("  Senha: ", senha, sizeof(senha));
        if (strcmp(usuario, USUARIO_PADRAO) == 0 && strcmp(senha, SENHA_PADRAO) == 0) {
            printf("\n  [Sucesso] Acesso autorizado com sucesso!\n");
            return 1;
        }
        printf("  [Erro] Usuario ou senha invalidos (%d/%d). Tente novamente.\n\n",
               tentativa, MAX_TENTATIVAS);
    }
    return 0;
}

int main(void) {
    int opcao;

#ifdef _WIN32
    SetConsoleOutputCP(65001);
#endif

    if (!fazerLogin()) {
        printf("\n  [Erro] Numero maximo de tentativas excedido. Encerrando o programa.\n");
        pausar();
        return 1;
    }

    carregarAcoes();
    
    do {
        exibirMenu();
        opcao = lerInteiro("  Escolha uma opcao: ", 1, 6);

        switch (opcao) {
            case 1: cadastrarAcao();    pausar(); break;
            case 2: listarAcoes();      pausar(); break;
            case 3: pesquisarAcao();    pausar(); break;
            case 4: atualizarSituacao(); pausar(); break;
            case 5: gerarResumo();      pausar(); break;
            case 6: 
                limparTela();
                printf("\n  [Aviso] Encerrando o sistema. Ate logo!\n"); 
                pausar(); 
                break; 
        }
    } while (opcao != 6);

    return 0;
}
